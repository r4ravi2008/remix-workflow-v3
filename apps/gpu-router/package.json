{
  "name": "gpu-router",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun src/dev.ts",
    "format": "oxfmt",
    "lint": "oxlint src test alchemy.run.ts",
    "build:worker": "bun build src/worker.ts --target browser --outfile .state/worker.js",
    "smoke": "bun src/smoke.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build:worker",
    "deploy": "alchemy deploy"
  },
  "dependencies": {
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261003.1",
    "@types/bun": "1.3.7",
    "alchemy": "2.0.0-beta.80",
    "oxfmt": "0.66.0",
    "oxlint": "1.85.0",
    "typescript": "7.0.2"
  }
}
